# syntax=docker/dockerfile:1.7

# Hosted-MCP image for the TEST Cloud 66 stack. Bakes @rundit-sdk/client
# at the `rc` npm dist-tag at image-build time (the production stack uses
# Dockerfile.hosted, which is identical except for the `latest` tag). Unlike
# ./Dockerfile — which reinstalls the SDK on every container start — the result
# is an immutable image: instant cold start, no npm egress at runtime.
#
# Redeploying (rebuilding) the stack picks up whatever `rc` points at at
# that moment; the build log prints `==> Baked @rundit-sdk/client@<version>`.

FROM node:24-alpine
WORKDIR /app

COPY package.json package-lock.json ./
# Install the lockfile, then move the SDK to the dist-tag. The override SAVES
# to the image's package.json/package-lock.json on purpose (no --no-save): the
# later `npm prune --omit=dev` reconciles against the lockfile and would roll a
# --no-save install back to the pinned version. Those manifests live only in
# this image and describe exactly what got baked.
RUN npm ci --include=dev --no-audit --no-fund \
 && npm install --include=dev --no-audit --no-fund @rundit-sdk/client@rc \
 && echo "==> Baked @rundit-sdk/client@$(node -p 'require("./node_modules/@rundit-sdk/client/package.json").version')"

COPY tsconfig.json ./
COPY scripts ./scripts
COPY src ./src

# codegen from the installed SDK's openapi.json + tsc, then drop dev deps.
RUN npm run build \
 && npm prune --omit=dev \
 && npm cache clean --force

# RUNDIT_BASE_URL defaults to the backend's in-cluster service address;
# override per environment at runtime if needed.
ENV NODE_ENV=production \
    MCP_TRANSPORT=http \
    PORT=3001 \
    RUNDIT_BASE_URL=http://backend:3000/api/v2/sdk

EXPOSE 3001
CMD ["node", "dist/main.js"]

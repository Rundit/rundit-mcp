# syntax=docker/dockerfile:1.7

# Hosted-MCP image for the PRODUCTION Cloud 66 stack. Installs the exact
# SDK version committed in package.json and package-lock.json on this branch.
# Update both manifests before deploying a new SDK release. The image builds
# its tool catalogue here and needs no npm access at runtime.

FROM node:24-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund \
 && echo "==> Baked @rundit-sdk/client@$(node -p 'require("./node_modules/@rundit-sdk/client/package.json").version')"

COPY tsconfig.json ./
COPY scripts ./scripts
COPY src ./src

# codegen from the installed SDK's openapi.json + tsc, then drop dev deps.
RUN npm run build \
 && npm prune --omit=dev \
 && npm cache clean --force

# RUNDIT_BASE_URL defaults to the backend's in-cluster service address;
# override per environment at runtime if needed.
ENV NODE_ENV=production \
    MCP_TRANSPORT=http \
    PORT=3001 \
    RUNDIT_BASE_URL=http://backend:3000/api/v2/sdk

EXPOSE 3001
CMD ["node", "dist/main.js"]
